# Copy this file to .env and fill in real values for your machine.
# Never commit the real .env file — it holds secrets.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of frontend URLs allowed to call this API from a
# browser. Defaults to the two local dev apps if unset; add your deployed
# apps/web and apps/staff URLs here in production.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Database ---
# Local dev default matches the Postgres database created during setup.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/kmeets_dev?schema=public"

# --- Redis (cache + background job queue) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Long random string used to sign login sessions. Generate your own with:
# `openssl rand -hex 32` — never reuse this example value anywhere real.
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- SMS / OTP provider ---
# Which adapter to use: "mock" (logs the OTP instead of sending a real SMS —
# safe default until you have a real MSG91 account) or "msg91".
SMS_PROVIDER="mock"
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- KYC provider ---
# Which adapter to use: "mock" (auto-approves after a short delay, for
# development) or "digio" / "signzy" once you have a real vendor account.
KYC_PROVIDER="mock"
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=

# --- Payments ---
# Which adapter to use: "mock" (simulates a successful payment instantly,
# no real money moves) or "razorpay" once you have a real merchant account.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- File storage ---
STORAGE_PROVIDER="local"
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Push notifications ---
PUSH_PROVIDER="mock"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
